# PiggyGuard deploy/demo environment (copy to .env, fill in, never commit .env)
PRIVATE_KEY=
BASE_SEPOLIA_RPC=https://sepolia.base.org
LASNA_RPC=
BASE_SEPOLIA_CALLBACK_PROXY=

# Addresses printed by earlier deploy steps (see README "Deploy")
PRICE_FEED=
VAULT=
REACTIVE=
CALLBACK=

# Optional overrides (defaults in script/Deploy.s.sol)
INITIAL_PRICE=10000000000
STOP_LOSS=9000000000
TAKE_PROFIT=12000000000
DCA_AMOUNT=1000000000
REACTIVE_RESERVE=100000000000000000

# Demo script overrides (script/Demo.s.sol)
DEMO_RISK=200000000
DEMO_SAFE=10000000000
DEMO_PRICE=8500000000
